# LebenslaufPro Environment Configuration
# Copy this file to .env and fill in your secrets.
# Streamlit also reads from .streamlit/secrets.toml (see example there).

# Required: Google Gemini API Key for AI translation & CV parsing
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
